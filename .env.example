# Gabarit local — copier en .env.local (ignoré par Git) ou lancer `vercel env pull .env.local`.
# Chaque clé lue par configs/env.ts est listée ici. Aucun vrai secret dans ce fichier.
# Les NEXT_PUBLIC_* sont inlinées dans le bundle navigateur : jamais de secret derrière ce préfixe.

# --- Supabase (projet mloaychfjhajdjfktcjp, région eu-central-1) --------------
# Noms identiques à ceux synchronisés par l'intégration Supabase ↔ Vercel.

# URL publique du projet (valeur par défaut dans configs/env.ts si absente).
NEXT_PUBLIC_SUPABASE_URL=https://mloaychfjhajdjfktcjp.supabase.co

# Clé publishable (sb_publishable_...) : publique par conception, protégée par la RLS.
# Dashboard Supabase → Project Settings → API Keys, ou outil MCP `get_publishable_keys`.
# Optionnelle au build : sans elle, l'app tourne mais toute lecture Supabase lève une erreur explicite.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (sb_secret_...) : SERVEUR UNIQUEMENT, contourne la RLS.
# Utilisée seulement par services/supabase/admin.ts (ingestion, route handlers).
# Laisser vide en local si inutile.
SUPABASE_SECRET_KEY=

# --- Featherless (serveur uniquement, jamais NEXT_PUBLIC_) --------------------
# Deux comptes. Chaque clé a sa propre file. FEATHERLESS_API_KEY seul compte comme la clé 1.
# FEATHERLESS_API_KEY_1 sert au script tag:articles ET à l'analyse des amendements
# (route /api/amendements/analysis, configs/env.ts). Sans clé : analyse en mode dégradé.
# À poser aussi sur Vercel (Production + Preview) pour l'analyse.
FEATHERLESS_API_KEY_1=
FEATHERLESS_API_KEY_2=

# Classifieur Simple Jev du script tag:articles. Vide → featherless-ai/gemma-4-12B-it-classifier.
FEATHERLESS_MODEL=

# Modèle de chat de l'analyse des amendements. Vide → zai-org/GLM-5.2.
FEATHERLESS_CHAT_MODEL=

# --- Application --------------------------------------------------------------

# development | preview | production. Vide → déduit de NEXT_PUBLIC_VERCEL_ENV
# (exposée automatiquement par Vercel), sinon "development".
NEXT_PUBLIC_ENVIRONMENT=development
