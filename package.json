{
  "name": "dandelion-open-data",
  "version": "0.1.0",
  "description": "Frontend web Dandelion Open Data, hackathon Open Data (Next.js + Supabase, déployé sur Vercel)",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test -c playwright.config.mjs",
    "supabase:login": "supabase login",
    "supabase:types": "supabase gen types typescript --project-id mloaychfjhajdjfktcjp --schema public > types/supabase.ts",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "lint:ds": "node scripts/lint-raw-values.mjs",
    "check": "pnpm lint && pnpm lint:ds && pnpm tokens:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@hookform/resolvers": "5.0.1",
    "@radix-ui/react-alert-dialog": "1.1.7",
    "@radix-ui/react-avatar": "1.1.4",
    "@radix-ui/react-checkbox": "1.1.5",
    "@radix-ui/react-dialog": "1.1.7",
    "@radix-ui/react-dropdown-menu": "2.1.7",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.3",
    "@radix-ui/react-popover": "1.1.7",
    "@radix-ui/react-radio-group": "1.2.4",
    "@radix-ui/react-scroll-area": "1.2.4",
    "@radix-ui/react-select": "2.1.7",
    "@radix-ui/react-slot": "1.2.0",
    "@radix-ui/react-switch": "1.1.4",
    "@radix-ui/react-tabs": "1.1.4",
    "@radix-ui/react-toggle": "1.1.3",
    "@radix-ui/react-toggle-group": "1.1.3",
    "@radix-ui/react-tooltip": "1.2.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@t3-oss/env-nextjs": "0.13.8",
    "@tanstack/react-query": "5.72.2",
    "axios": "1.13.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.487.0",
    "motion": "12.7.4",
    "next": "15.5.24",
    "next-intl": "4.0.2",
    "next-themes": "0.4.6",
    "nextjs-toploader": "3.8.16",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "7.55.0",
    "react-intersection-observer": "10.0.2",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "three": "0.187.0",
    "tw-animate-css": "1.2.5",
    "vaul": "1.1.2",
    "zod": "3.24.2",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/node": "4.1.3",
    "@tailwindcss/postcss": "4.1.3",
    "@types/lodash": "4.17.23",
    "@types/node": "20.17.30",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.2",
    "@types/three": "0.187.0",
    "eslint": "9.24.0",
    "eslint-config-next": "15.5.24",
    "lodash": "4.17.21",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "supabase": "3.1.0",
    "tailwindcss": "4.1.3",
    "typescript": "5.8.3",
    "vitest": "4.1.5"
  }
